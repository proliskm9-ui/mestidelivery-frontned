{
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "partners/**",
      "index.html"
    ],
    "redirects": [
      { "source": "/partners", "destination": "https://mestidelivery.com/partners/", "type": 301 },
      { "source": "/partners/**", "destination": "https://mestidelivery.com/partners/:splat", "type": 301 },
      { "source": "/", "destination": "https://mestidelivery.com/", "type": 302 },
      { "source": "/index.html", "destination": "https://mestidelivery.com/", "type": 302 }
    ]
  }
}
