# =============================================
# MESTIGO API - PRODUCTION SERVER CONFIG
# For self-hosted VPS with Certbot SSL
# =============================================

# Environment
ENV=production
LOG_LEVEL=INFO

# Database - Supabase PostgreSQL
# Format: postgresql+asyncpg://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql+asyncpg://postgres.XXXXX:YOUR_PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# Security - ОБЯЗАТЕЛЬНО ПОМЕНЯЙТЕ!
SECRET_KEY=your-super-secret-key-minimum-32-characters

# Server
HOST=0.0.0.0
PORT=3001
API_URL=http://mestigo.loseyourip.com:3001
WORKERS=4
API_URL=http://mestigo.loseyourip.com:3001

# SSL Certificate paths (Certbot)
# Замените api.yourdomain.com на ваш домен
SSL_KEYFILE=/etc/letsencrypt/live/api.yourdomain.com/privkey.pem
SSL_CERTFILE=/etc/letsencrypt/live/api.yourdomain.com/fullchain.pem

# CORS
CORS_ORIGINS=*

# Upload settings
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=5242880

# Service fee (hidden from customers, in percent)
SERVICE_FEE_PERCENT=5

# Auto seed database on startup
AUTO_SEED=false

# Enable API docs (disable in production!)
ENABLE_DOCS=false

# Telegram Bot (optional)
BOT_TOKEN=
ADMIN_IDS=

# Supabase Storage (optional)
SUPABASE_URL=
SUPABASE_KEY=
