# Firebase Web config (Auth + Firestore). Google Sign-In must be enabled in Console.
# Values: Firebase Console → Project settings → Your apps → Web app

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=mestidelivery.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=mestidelivery
VITE_FIREBASE_STORAGE_BUCKET=mestidelivery.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Backend API (production build uses .env.production; local dist: npm run build:local)
# VITE_API_URL=http://localhost:8080
# VITE_PICTURE_API_URL=http://localhost:8080
