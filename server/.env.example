# =============================================================================
# Mestigo API - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values
# NEVER commit .env file to version control!
# =============================================================================

# =============================================================================
# Supabase (REQUIRED)
# =============================================================================
# Get these from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key-here

# =============================================================================
# Server Settings
# =============================================================================
HOST=0.0.0.0
PORT=443

# Number of worker processes (production)
WORKERS=4

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Enable API documentation (set to true for development)
ENABLE_DOCS=false

# =============================================================================
# Security (IMPORTANT!)
# =============================================================================
# Generate a secure key: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=CHANGE_THIS_TO_A_SECURE_RANDOM_STRING

# JWT token expiration in days
JWT_EXPIRE_DAYS=7

# =============================================================================
# CORS Settings
# =============================================================================
# Comma-separated list of allowed origins
# Example: https://your-domain.com,https://web.telegram.org
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://web.telegram.org

# Set to true to allow all origins (NOT recommended for production!)
CORS_ALLOW_ALL=false

# =============================================================================
# Telegram Bot
# =============================================================================
# Get from @BotFather
BOT_TOKEN=your-bot-token-here

# Comma-separated list of admin Telegram user IDs
ADMIN_IDS=123456789,987654321

# =============================================================================
# File Upload
# =============================================================================
UPLOAD_DIR=./uploads

# Max file size in bytes (default: 5MB)
MAX_UPLOAD_SIZE=5242880

# Supabase storage bucket name
SUPABASE_STORAGE_BUCKET=images

# =============================================================================
# Business Settings
# =============================================================================
# Service fee as percentage of order subtotal
SERVICE_FEE_PERCENT=5

# Default delivery fee
DEFAULT_DELIVERY_FEE=5

# Currency settings
CURRENCY_SYMBOL=₾
CURRENCY_CODE=GEL

# =============================================================================
# Rate Limiting
# =============================================================================
# Maximum requests per window
RATE_LIMIT_REQUESTS=100

# Window size in seconds
RATE_LIMIT_WINDOW=60

# =============================================================================
# Pagination
# =============================================================================
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# =============================================================================
# SSL/TLS (Production)
# =============================================================================
# Paths to SSL certificate files (Let's Encrypt / Certbot)
SSL_KEYFILE=./certs/privkey.pem
SSL_CERTFILE=./certs/fullchain.pem
